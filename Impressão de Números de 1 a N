#include <stdio.h>

void imprimirAteN(int numero) {
    for (int i = 1; i <= numero; i++) {
        printf("%d ", i);
    }
    printf("\n");
}

int main() {
    int numero;
    
    while (1) {
        printf("Digite qualquer número inteiro positivo: ");
        scanf("%d", &numero);
        
        if (numero > 0) {
            break; 
        } else {
            printf("Número inválido! Tente novamente.\n");
        }
    }
    
    imprimirAteN(numero);
    
    return 0;
}
