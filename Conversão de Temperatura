#include <stdio.h>
int main() {

    int numero;
    double celsius, fahrenheit, resultado;
    
    
        while(1){
            printf("---Qual temperatura você quer converter?---\n1-Fahrenheit\n2-Celsius\n");
        if(scanf("%d", &numero) != 1) {
            printf("Digite um número válido.\n");
            while (getchar() != '\n');
            continue;
        }
        if (numero == 1) {
            printf("Digite o valor da temperatura em Fahrenheit que quer converter: \n");
            scanf("%lf", &fahrenheit);

            resultado = (fahrenheit - 32.0) * (5.0 / 9.0);
            printf("%.2f Fahrenheit = %.2f Celsius.", fahrenheit, resultado);
            break;

        }else if (numero == 2){
            printf("Digite o valor da temperatura em Celsius que quer converter: \n");
            scanf("%lf", &celsius);

            resultado = (celsius * 9.0 / 5.0) + 32.0;
            printf("%.2f Celsius = %.2f Fahrenheit.", celsius, resultado);
            break;
        }else{
            printf("Digite um número válido.\n");
        }
    }
    

    return 0;
}

