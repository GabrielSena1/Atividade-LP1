#include <stdio.h>
int main() {

    int numeros[5];
    int soma = 0;
    while (1) {
        int entrada_valida = 1;
    printf("Digite os 5 números separados por espaço: ");
    for (int i = 0; i < 5; i++) {
        if(scanf("%d", &numeros[i]) != 1) {
            entrada_valida = 0;
            break;
        }
    }
    if (entrada_valida) {
        for (int i = 0; i < 5; i++) {
            soma += numeros[i];
        }
        printf("A soma é %d\n", soma);
            break;
    }else {
        printf("Entrada inválida (ltras não são permitidas) Tente novamente.\n");
        while (getchar() != '\n');
    }
}

    return 0;
}

